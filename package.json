{
  "packageManager": "pnpm@12.16.1",
  "name": "tw-minesweeper-client",
  "scripts": {
    "check": "tsc --noEmit",
    "serve": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm run lint:prettier && pnpm run lint:stylelint && pnpm run lint:eslint",
    "lint:fix": "pnpm run lint:prettier:fix && pnpm run lint:stylelint:fix && pnpm run lint:eslint:fix",
    "lint:prettier": "prettier --check src",
    "lint:prettier:fix": "prettier --write src",
    "lint:stylelint": "stylelint 'src/**/*.css'",
    "lint:stylelint:fix": "stylelint --fix 'src/**/*.css'",
    "lint:eslint": "eslint src",
    "lint:eslint:fix": "eslint --fix src",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
