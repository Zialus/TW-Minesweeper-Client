{
  "packageManager": "pnpm@12.3.4",
  "name": "tw-minesweeper-client",
  "scripts": {
    "check": "tsc --noEmit",
    "serve": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm run lint:prettier && pnpm run lint:stylelint && pnpm run lint:eslint",
    "lint:fix": "pnpm run lint:prettier:fix && pnpm run lint:stylelint:fix && pnpm run lint:eslint:fix",
    "lint:prettier": "prettier --check src",
    "lint:prettier:fix": "prettier --write src",
    "lint:stylelint": "stylelint 'src/**/*.css'",
    "lint:stylelint:fix": "stylelint --fix 'src/**/*.css'",
    "lint:eslint": "eslint src",
    "lint:eslint:fix": "eslint --fix src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
